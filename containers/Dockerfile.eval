# Prebuilt evaluation image for the OpenAI-compatible backend: every Python
# package a run needs, and the pinned lm-evaluation-harness, so nothing is
# installed at run time. The image sets EVAL_PREBUILT_ENV=1, which makes the
# launcher skip the environment-preparation job and run_lm_eval.sbatch /
# run_inspect_eval.sh use this environment as is.
#
# CI publishes it for every pushed commit as
# ghcr.io/swiss-ai/evals-post-train-eval:<commit>; run it with the scripts from
# that same commit. Built from the repository root:
#   docker build -f containers/Dockerfile.eval .

# Pinned by digest, and every package below comes from a requirements/*.lock
# (scripts/common/lock_requirements.sh), so builds of different commits get the
# same packages unless a lock changed.
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# lm-eval-harness's packages get their own virtualenv like every other tool below, and its
# bin comes first on PATH (end of file), so the image's `python` is this one. It runs on
# Python 3.13 (the image's own 3.12 stays for the other venvs): uv installs the interpreter, pinned like the lock, as scripts/common/locked_venv.sh does
# outside the image. No model is loaded in this image, so the lock has CPU torch, from
# PyTorch's index. The lock's hashes decide which file is accepted, whichever index has it.
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /usr/local/bin/uv
COPY requirements/lm-eval-runtime.lock requirements/inspect-runtime.lock /tmp/requirements/
# tree_sitter==0.21.3 (bfcl scoring) has no Python 3.13 wheel, so it is built from source:
# the compiler is only there for this layer.
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends build-essential \
    && UV_PYTHON_INSTALL_DIR=/opt/python uv venv --seed --python 3.13.14 /opt/lm-eval-venv \
    && /opt/lm-eval-venv/bin/pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
        -r /tmp/requirements/lm-eval-runtime.lock \
    && apt-get purge -y -qq --auto-remove build-essential \
    && rm -rf /var/lib/apt/lists/*

# NLTK's data (ifeval, multi_if, ruler, ifbench) is baked in: /opt/lm-eval-venv/nltk_data is on
# NLTK's search path, root-owned and read-only. Downloading at run time put it in the run's
# folder on shared storage, which NLTK refuses (group-writable), and failed ifeval with
# "Resource 'punkt_tab' not found". With the data here, the harness finds it and downloads nothing.
RUN /opt/lm-eval-venv/bin/python -m nltk.downloader -d /opt/lm-eval-venv/nltk_data \
        punkt punkt_tab stopwords averaged_perceptron_tagger_eng \
    && /opt/lm-eval-venv/bin/python -c "import nltk; nltk.data.find('tokenizers/punkt_tab/english/')"

# Inspect gets its own virtualenv: lm-eval-harness pins datasets==4.0.0, and
# in one environment pip would resolve inspect-evals to the last release that
# accepts it (January 2026) instead of the pinned one. run_inspect_eval.sh puts
# EVAL_INSPECT_VENV/bin first on PATH.
RUN python -m venv /opt/inspect-venv \
    && /opt/inspect-venv/bin/pip install --no-cache-dir -r /tmp/requirements/inspect-runtime.lock

# EvalScope (SWE-bench Verified and Pro, run_evalscope_eval.sh) in a third one:
# its math-verify pin conflicts with lm-eval-runtime.txt's antlr4. SWE-bench_Pro-os,
# which EvalScope would otherwise clone at run time, is checked out at the commit
# the installed EvalScope pins (EVALSCOPE_SWE_BENCH_PRO_REPO).
COPY requirements/evalscope-runtime.lock /tmp/requirements/
RUN python -m venv /opt/evalscope-venv \
    && /opt/evalscope-venv/bin/pip install --no-cache-dir -r /tmp/requirements/evalscope-runtime.lock \
    && pro=$(/opt/evalscope-venv/bin/python -c \
        "from evalscope.benchmarks.swe_bench_pro.utils import PRO_REPO_URL, PINNED_COMMIT; print(PRO_REPO_URL, PINNED_COMMIT)") \
    && set -- $pro \
    && git clone --quiet "$1" /opt/swe-bench-pro-os \
    && git -C /opt/swe-bench-pro-os checkout --quiet "$2" \
    && git -C /opt/swe-bench-pro-os rev-parse HEAD > /opt/swe-bench-pro-os.commit \
    && rm -rf /opt/swe-bench-pro-os/.git

# Harbor (agentic benchmarks, run_harbor_eval.sh) in a fourth: it pins its own
# dependency set. Multi-SWE-bench has no published Harbor dataset, only an
# adapter that generates the tasks; run.py would fetch it with uvx at run time,
# so it is installed here from the same Harbor tag (HARBOR_VERSION in
# scripts/harbor/run.py, the harbor pin in harbor-runtime.txt), as
# HARBOR_ADAPTERS_ROOT/<adapter>/bin/<adapter>.
COPY requirements/harbor-runtime.lock requirements/harbor-adapters.lock /tmp/requirements/
RUN python -m venv /opt/harbor-venv \
    && /opt/harbor-venv/bin/pip install --no-cache-dir -r /tmp/requirements/harbor-runtime.lock \
    && python -m venv /opt/harbor-adapters/multi-swe-bench \
    && /opt/harbor-adapters/multi-swe-bench/bin/pip install --no-cache-dir -r /tmp/requirements/harbor-adapters.lock \
    && /opt/harbor-adapters/multi-swe-bench/bin/multi-swe-bench --help >/dev/null

# tau2-bench (tau-bench, run_tau2_bench.sh) in a fifth: Python >= 3.12 and its own
# dependency set. It is not on PyPI and reads its tasks from a data directory next to
# the code, so that directory is checked out at the commit the lock pins
# (TAU2_DATA_DIR); run_tau2_bench.sh compares --git-ref against TAU2_COMMIT_FILE.
COPY requirements/tau2-runtime.lock /tmp/requirements/
RUN python -m venv /opt/tau2-venv \
    && /opt/tau2-venv/bin/pip install --no-cache-dir -r /tmp/requirements/tau2-runtime.lock \
    && commit=$(grep -oE 'tau2-bench@[0-9a-f]{40}' /tmp/requirements/tau2-runtime.lock | cut -d@ -f2) \
    && test -n "$commit" \
    && git init --quiet /opt/tau2-bench \
    && git -C /opt/tau2-bench fetch --quiet --depth 1 https://github.com/sierra-research/tau2-bench.git "$commit" \
    && git -C /opt/tau2-bench checkout --quiet FETCH_HEAD \
    && printf '%s\n' "$commit" > /opt/tau2-bench.commit \
    && rm -rf /opt/tau2-bench/.git \
    && TAU2_DATA_DIR=/opt/tau2-bench/data /opt/tau2-venv/bin/python -c "import tau2"

# GDPval-AA (run_gdpval.sh) in a sixth: the Stirrup agent, the dataset download and
# the judge-panel clients.
COPY requirements/gdpval-runtime.lock /tmp/requirements/
RUN python -m venv /opt/gdpval-venv \
    && /opt/gdpval-venv/bin/pip install --no-cache-dir -r /tmp/requirements/gdpval-runtime.lock \
    && /opt/gdpval-venv/bin/python -c "import stirrup.tools.code_backends.e2b"

# Each pinned harness as its own --no-deps overlay, the same layout
# build_eval_env.sh produces, so several forks (all the lm_eval package)
# could live side by side. run_lm_eval.sbatch checks .commit against the pin
# in the checkout it runs from.
COPY requirements/lm-eval-harness.txt /tmp/requirements/
RUN grep -Ev '^[[:space:]]*(#|$)' /tmp/requirements/lm-eval-harness.txt \
    | while read -r repo commit; do \
        target="/opt/lm-eval-harness/$repo"; \
        /opt/lm-eval-venv/bin/pip install --no-cache-dir --no-deps --target "$target" \
            "git+https://github.com/$repo.git@$commit" || exit 1; \
        PYTHONPATH="$target" /opt/lm-eval-venv/bin/python -c "import lm_eval" || exit 1; \
        printf '%s\n' "$commit" > "$target/.commit"; \
        touch "$target/.complete"; \
    done

ENV PATH=/opt/lm-eval-venv/bin:$PATH \
    LM_EVAL_VENV=/opt/lm-eval-venv \
    EVAL_PREBUILT_ENV=1 \
    EVAL_PREBUILT_HARNESS_ROOT=/opt/lm-eval-harness \
    EVAL_INSPECT_VENV=/opt/inspect-venv \
    EVALSCOPE_VENV=/opt/evalscope-venv \
    EVALSCOPE_SWE_BENCH_PRO_REPO=/opt/swe-bench-pro-os \
    HARBOR_VENV=/opt/harbor-venv \
    HARBOR_ADAPTERS_ROOT=/opt/harbor-adapters \
    TAU2_VENV=/opt/tau2-venv \
    TAU2_DATA_DIR=/opt/tau2-bench/data \
    TAU2_COMMIT_FILE=/opt/tau2-bench.commit \
    GDPVAL_VENV=/opt/gdpval-venv

WORKDIR /work
