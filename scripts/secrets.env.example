# Copy to scripts/secrets.env (gitignored) and fill in the keys you have; leave the rest empty.
# One NAME=value per line. A variable already set in the environment wins over this file.
# See the Credentials section of the README for what each key is for.

# CSCS serving (https://serving.swissai.cscs.ch): --api-base-url runs and LLM judges.
CSCS_SERVING_API=
# Weights & Biases: uploading results.
WANDB_API_KEY=
# Hugging Face: gated or rate-limited datasets and models.
HF_TOKEN=
# Optional: the lm-eval gpt suite and Inspect openai/... model roles.
OPENAI_API_KEY=
# Optional: CritPt grading (ask critpt@artificialanalysis.ai).
CRITPT_API_KEY=
# Optional: --sandbox opensandbox (Harbor, EvalScope, Inspect) and run_gdpval.sh --sandbox-backend opensandbox.
OPENSANDBOX_API_KEY=
