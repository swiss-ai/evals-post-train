{
  "name": "apertus2-chonk-sft",
  "title": "Compare Chonk to other post-trained thinking models",
  "description": "Benchmarks for Apertus 2 Chonk SFT and the models it is compared with (Apertus 1.5 70B and 8B, Qwen3 32B), in table order. Mean@8 for AIME, mean@4 for the rest. MATH is not listed yet: its task (hendrycks_math or minerva_math) is undecided.",
  "benchmarks": [
    {"label": "MMLU", "task": "mmlu_0_shot", "framework": "inspect",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null},
     "task_args": {"cot": "true"}},
    {"label": "GPQA", "task": "gpqa_main_cot_zeroshot", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null}},
    {"label": "IFBench", "task": "ifbench", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": "prompt_level_loose_acc_mean_repeats,none"}},
    {"label": "GSM8K", "task": "gsm8k", "framework": "inspect",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null},
     "task_args": {"fewshot": "0"}},
    {"label": "MATH-500", "task": "minerva_math500_self_consistency", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "task"}, "metric": {"label": "mean@4", "key": "math_verify,mean@4"}},
    {"label": "AIME 24", "task": "aime2024", "framework": "inspect",
     "repeats": {"n": 8, "via": "flag"}, "metric": {"label": "mean@8", "key": null}},
    {"label": "AIME 25", "task": "aime2025", "framework": "inspect",
     "repeats": {"n": 8, "via": "flag"}, "metric": {"label": "mean@8", "key": null}}
  ],
  "setups": {
    "apertus-1.5-70b-thinking": {
      "description": "swiss-ai/Apertus-v1.5-70B reasoning (--thinking with its <|inner_prefix|> / <|inner_suffix|> tokens). Window 32768.",
      "max_length": 32768,
      "sampling": "thinking",
      "flags": {
        "lm_eval": ["--thinking", "--think-start-token", "<|inner_prefix|>", "--think-end-token", "<|inner_suffix|>"],
        "inspect": ["--enable-thinking"]
      }
    },
    "apertus-1.5-8b-thinking": {
      "description": "swiss-ai/Apertus-v1.5-8B reasoning (--thinking with its <|inner_prefix|> / <|inner_suffix|> tokens). Window 32768, as for the 70B.",
      "max_length": 32768,
      "sampling": "thinking",
      "flags": {
        "lm_eval": ["--thinking", "--think-start-token", "<|inner_prefix|>", "--think-end-token", "<|inner_suffix|>"],
        "inspect": ["--enable-thinking"]
      }
    },
    "qwen3-32b-thinking": {
      "description": "Qwen/Qwen3-32B reasoning (--thinking with explicit <think> / </think> tokens). Window 32768, its native context.",
      "max_length": 32768,
      "sampling": "thinking",
      "flags": {
        "lm_eval": ["--thinking", "--think-end-token", "</think>", "--think-start-token", "<think>"],
        "inspect": ["--enable-thinking"]
      }
    },
    "apertus-2-chonk-sft": {
      "description": "Apertus 2 Chonk SFT, native format (no Jinja template). The window 16384 is the checkpoint's name, not yet the maximal window.",
      "max_length": 16384,
      "sampling": "thinking",
      "flags": {
        "lm_eval": ["--chat-format", "apertus2", "--tokenizer", "apertus-2-instruct-tokenizer"],
        "inspect": []
      }
    }
  }
}
