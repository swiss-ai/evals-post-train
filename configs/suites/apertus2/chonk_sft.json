{
  "name": "apertus2-chonk-sft",
  "title": "Compare Chonk to other post-trained thinking models",
  "description": "Benchmarks for Apertus 2 Chonk SFT and the models it is compared with (Apertus 1.5 70B and 8B, Qwen3 32B), in table order. Mean@8 for AIME, mean@4 for the rest. MATH is not listed yet: its task (hendrycks_math or minerva_math) is undecided. HLE is judged by GLM-5.3 (plain-text judge prompt), SciCode and GDPval run their code in OpenSandbox (Kata); GDPval only generates, its grading is a separate submission. HarmBench, MultiJail and Aya red-teaming are lm-eval groups judged by a fixed model through the SwissAI API (HarmBench's classifier cais/HarmBench-Llama-2-13b-cls, Llama-3.3-70B-Instruct for the other two; lower is safer); only HarmBench repeats in the harness, the other two score once. MedQA and MedXpertQA (text subset) are the harness's generative step-by-step tasks scored on the last \"Final Answer: X\"; HealthBench is inspect_evals' full set (5,000 conversations), each rubric criterion judged by Gemma-4-31B-it through the SwissAI API.",
  "benchmarks": [
    {"label": "MMLU", "task": "mmlu_0_shot", "framework": "inspect",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null},
     "task_args": {"cot": "true"}},
    {"label": "GPQA", "task": "gpqa_diamond", "framework": "inspect",
     "repeats": {"n": 4, "via": "task"}, "metric": {"label": "mean@4", "key": null}},
    {"label": "IFBench", "task": "ifbench", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": "prompt_level_loose_acc_mean_repeats,none"}},
    {"label": "IFEval", "task": "ifeval", "framework": "inspect",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null}},
    {"label": "GSM8K", "task": "gsm8k", "framework": "inspect",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null},
     "task_args": {"fewshot": "0"}},
    {"label": "MATH-500", "task": "minerva_math500_self_consistency", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "task"}, "metric": {"label": "mean@4", "key": "math_verify,mean@4"}},
    {"label": "AIME 24", "task": "aime2024", "framework": "inspect",
     "repeats": {"n": 8, "via": "flag"}, "metric": {"label": "mean@8", "key": null}},
    {"label": "AIME 25", "task": "aime2025", "framework": "inspect",
     "repeats": {"n": 8, "via": "flag"}, "metric": {"label": "mean@8", "key": null}},
    {"label": "BFCL v3 (FC)", "task": "bfcl_v3_fc", "framework": "lm_eval",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "acc", "key": null}},
    {"label": "BFCL v4 (tool-call signal)", "task": "bfcl_v4", "framework": "evalscope",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "acc", "key": null}},
    {"label": "HLE", "task": "hle", "framework": "inspect",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "acc", "key": null},
     "flags": ["--model-role", "grader=openai-api/swissai/CSCS-Inference/zai-org/GLM-5.3", "--model-role", "grader_2=openai-api/swissai/CSCS-Inference/zai-org/GLM-5.3"],
     "task_args": {"judge_prompt": "grade_c_i"}},
    {"label": "SciCode", "task": "scicode", "framework": "inspect",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "acc", "key": null},
     "flags": ["--sandbox", "opensandbox"]},
    {"label": "GDPval", "task": "gdpval", "framework": "inspect",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "acc", "key": null},
     "flags": ["--sandbox", "opensandbox"]},
    {"label": "SWE-bench Verified", "task": "swe_bench", "framework": "harbor",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "resolved", "key": null},
     "flags": ["--sandbox", "opensandbox"]},
    {"label": "HarmBench", "task": "harmbench", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null}},
    {"label": "MultiJail", "task": "multijail", "framework": "lm_eval",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "unsafe", "key": null}},
    {"label": "Aya red-teaming", "task": "aya_redteaming", "framework": "lm_eval",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "harmful", "key": null}},
    {"label": "MedQA", "task": "medqa_4options_cot", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null}},
    {"label": "MedXpertQA", "task": "medxpertqa_cot", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null}},
    {"label": "HealthBench", "task": "healthbench", "framework": "inspect",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "score", "key": null},
     "task_args": {"judge_model": "openai-api/swissai/CSCS-Inference/google/gemma-4-31B-it"}}
  ],
  "setups": {
    "apertus-1.5-70b-thinking": {
      "description": "swiss-ai/Apertus-v1.5-70B reasoning (--thinking with its <|inner_prefix|> / <|inner_suffix|> tokens). Window 32768. Client concurrency 256 (lm_eval): the default 8 leaves its two replicas idle (evals-svc runs it on 2 nodes, TP4 x DP2): 18 min instead of 28 for full gsm8k x4 at 64, 34 on one node; 512 gave nothing more (the longest generation bounds the run).",
      "max_length": 32768,
      "sampling": "thinking",
      "flags": {
        "lm_eval": ["--thinking", "--think-start-token", "<|inner_prefix|>", "--think-end-token", "<|inner_suffix|>", "--api-num-concurrent", "256"],
        "inspect": ["--enable-thinking"],
        "evalscope": [],
        "harbor": ["--enable-thinking", "--agent-kwarg", "model_info={\"max_input_tokens\": 32768}"]
      },
      "task_flags": {
        "bfcl_v3_fc": ["--thinking", "--think-start-token", "<|inner_prefix|>", "--think-end-token", "<|inner_suffix|>", "--api-endpoint", "chat-completions", "--api-num-concurrent", "256"]
      }
    },
    "apertus-1.5-8b-thinking": {
      "description": "swiss-ai/Apertus-v1.5-8B reasoning (--thinking with its <|inner_prefix|> / <|inner_suffix|> tokens). Window 32768, as for the 70B.",
      "max_length": 32768,
      "sampling": "thinking",
      "flags": {
        "lm_eval": ["--thinking", "--think-start-token", "<|inner_prefix|>", "--think-end-token", "<|inner_suffix|>"],
        "inspect": ["--enable-thinking"],
        "evalscope": [],
        "harbor": ["--enable-thinking", "--agent-kwarg", "model_info={\"max_input_tokens\": 32768}"]
      },
      "task_flags": {
        "bfcl_v3_fc": ["--thinking", "--think-start-token", "<|inner_prefix|>", "--think-end-token", "<|inner_suffix|>", "--api-endpoint", "chat-completions"]
      }
    },
    "qwen3-32b-thinking": {
      "description": "Qwen/Qwen3-32B reasoning (--thinking with explicit <think> / </think> tokens). Window 32768, its native context.",
      "max_length": 32768,
      "sampling": "thinking",
      "flags": {
        "lm_eval": ["--thinking", "--think-end-token", "</think>", "--think-start-token", "<think>"],
        "inspect": ["--enable-thinking"],
        "evalscope": [],
        "harbor": ["--enable-thinking", "--agent-kwarg", "model_info={\"max_input_tokens\": 32768}"]
      },
      "task_flags": {
        "bfcl_v3_fc": ["--thinking", "--think-end-token", "</think>", "--think-start-token", "<think>", "--api-endpoint", "chat-completions"]
      }
    },
    "chonk-lc-16k-v0.2-sft": {
      "description": "SwissAI-Research/swiss-ai/chonk-lc-16k-v0.2-sft. No Jinja template exists: apertus-common renders the format, in lm_eval (--chat-format apertus2, completions endpoint, needs --backend openai and the verified Apertus_2_instruct tokenizer, pinned in `tokenizer`) and on the server for the other frameworks (vLLM plugin of apertus-common PR #5, see docs/thinking.md). The window 16384 is the checkpoint's name (16k), not a decided maximum. It only reasons at effort high on non-math tasks.",
      "max_length": 16384,
      "sampling": "thinking",
      "reasoning_effort": "high",
      "tokenizer": {"repo": "https://github.com/swiss-ai/apertus-omni-tokenizer.git", "revision": "b801ff1b00d933d10bba90b0c22307157299faa7", "path": "tokenizers/Apertus_2_instruct"},
      "serving": ["--tokenizer-mode", "apertus2", "--reasoning-parser", "apertus2", "--enable-auto-tool-choice", "--tool-call-parser", "apertus2"],
      "flags": {
        "lm_eval": ["--backend", "openai", "--chat-format", "apertus2"],
        "inspect": [],
        "evalscope": [],
        "harbor": ["--agent-kwarg", "model_info={\"max_input_tokens\": 16384}"]
      },
      "task_flags": {
        "bfcl_v3_fc": ["--backend", "openai", "--api-endpoint", "chat-completions", "--enable-thinking"]
      }
    },
    "chonk-lc-16k-v0.1-ep1": {
      "description": "Same settings as chonk-lc-16k-v0.2-sft (apertus-common format, 16k window, effort high, tokenizer and serving options), for the earlier chonk-lc-16k-v0.1-ep1 checkpoint.",
      "max_length": 16384,
      "sampling": "thinking",
      "reasoning_effort": "high",
      "tokenizer": {"repo": "https://github.com/swiss-ai/apertus-omni-tokenizer.git", "revision": "b801ff1b00d933d10bba90b0c22307157299faa7", "path": "tokenizers/Apertus_2_instruct"},
      "serving": ["--tokenizer-mode", "apertus2", "--reasoning-parser", "apertus2", "--enable-auto-tool-choice", "--tool-call-parser", "apertus2"],
      "flags": {
        "lm_eval": ["--backend", "openai", "--chat-format", "apertus2"],
        "inspect": [],
        "evalscope": [],
        "harbor": ["--agent-kwarg", "model_info={\"max_input_tokens\": 16384}"]
      },
      "task_flags": {
        "bfcl_v3_fc": ["--backend", "openai", "--api-endpoint", "chat-completions", "--enable-thinking"]
      }
    }
  }
}
