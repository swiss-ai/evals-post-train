{
  "name": "apertus2-chonk-sft",
  "title": "Compare Chonk to other post-trained thinking models",
  "description": "Benchmarks for Apertus 2 Chonk SFT and the models it is compared with (Apertus 1.5 70B and 8B, Qwen3 32B), in table order. Mean@4 default, some agentic's pass@1. GSM8K Platinum runs the gsm8k_platinum_think lm-eval task (same DAPO prompt, 4 samples inside the task). AIME runs the aime24_think and aime25_think lm-eval tasks (the DAPO prompt asking for a final \"Answer: $Answer\" line),, repeated 4 times by the launcher like the other rows: mean@4. MATH-500 runs the minerva_math500_think lm-eval task (the same DAPO prompt, scored with math_verify, 4 samples inside the task). HLE is judged by GLM-5.3 (plain-text judge prompt), SciCode and GDPval run their code in OpenSandbox (Kata); GDPval only generates, its grading is a separate submission. HarmBench, MultiJail and Aya red-teaming are lm-eval groups judged by a fixed model through the SwissAI API (HarmBench's classifier cais/HarmBench-Llama-2-13b-cls, Llama-3.3-70B-Instruct for the other two; lower is safer); only HarmBench repeats in the harness, the other two score once.",
  "benchmarks": [
    {"label": "GPQA Diamond", "task": "gpqa_diamond", "framework": "inspect",
     "repeats": {"n": 4, "via": "task"}, "metric": {"label": "mean@4", "key": null}},
    {"label": "IFBench", "task": "ifbench", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": "prompt_level_loose_acc_mean_repeats,none"}},
    {"label": "IFEval", "task": "ifeval", "framework": "inspect",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null}},
    {"label": "GSM8K Platinum", "task": "gsm8k_platinum_think", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "task"}, "metric": {"label": "mean@4", "key": "exact_match,mean@4"}},
    {"label": "MATH-500", "task": "minerva_math500_think", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "task"}, "metric": {"label": "mean@4", "key": "math_verify,mean@4"}},
    {"label": "AIME 24", "task": "aime24_think", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": "exact_match_mean_repeats,score-first"}},
    {"label": "AIME 25", "task": "aime25_think", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": "exact_match_mean_repeats,score-first"}},
    {"label": "BFCL v3", "task": "bfcl_v3", "framework": "bfcl",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "acc", "key": "overall"}},
    {"label": "BFCL v4", "task": "bfcl_v4", "framework": "bfcl",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "acc", "key": null}},
    {"label": "tau2-bench airline", "task": "airline", "framework": "tau2",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "pass@1", "key": null}},
    {"label": "tau2-bench retail", "task": "retail", "framework": "tau2",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "pass@1", "key": null}},
    {"label": "tau2-bench telecom", "task": "telecom", "framework": "tau2",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "pass@1", "key": null}},
    {"label": "tau2-bench banking_knowledge", "task": "banking_knowledge", "framework": "tau2",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "pass@1", "key": null}},
    {"label": "HarmBench", "task": "harmbench", "framework": "lm_eval",
     "repeats": {"n": 4, "via": "flag"}, "metric": {"label": "mean@4", "key": null}},
    {"label": "MultiJail", "task": "multijail", "framework": "lm_eval",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "unsafe", "key": null}},
    {"label": "Aya red-teaming", "task": "aya_redteaming", "framework": "lm_eval",
     "repeats": {"n": 1, "via": "task"}, "metric": {"label": "harmful", "key": null}}
  ],
  "setups": {
    "apertus-1.5-70b-thinking": {
      "description": "swiss-ai/Apertus-v1.5-70B reasoning (--thinking with its <|inner_prefix|> / <|inner_suffix|> tokens). Window 262144, as evals-svc serves it. Client concurrency 256 (lm_eval): the default 8 leaves its two replicas idle (evals-svc runs it on 2 nodes, TP4 x DP2): 18 min instead of 28 for full gsm8k x4 at 64, 34 on one node; 512 gave nothing more (the longest generation bounds the run).",
      "max_length": 262144,
      "sampling": "thinking",
      "launch": {
        "model_path": "/capstor/store/cscs/swissai/infra01/hf_models/models/swiss-ai/Apertus-v1.5-70B",
        "environment": "containers/env_vllm_apertus1p5.toml",
        "nodes": 2,
        "time": "24:00:00",
        "framework_args": ["--chat-template-content-format", "string", "--tensor-parallel-size", "4", "--data-parallel-size", "2", "--data-parallel-size-local", "1", "--data-parallel-backend", "ray", "--gpu-memory-utilization", "0.8", "--max-model-len", "262144", "--reasoning-parser", "apertus", "--default-chat-template-kwargs.enable_thinking", "true", "--compilation-config.pass_config.fuse_allreduce_rms", "false", "--enable-auto-tool-choice", "--tool-call-parser", "apertus"]
      },
      "flags": {
        "lm_eval": ["--thinking", "--think-start-token", "<|inner_prefix|>", "--think-end-token", "<|inner_suffix|>", "--api-num-concurrent", "256"],
        "inspect": ["--enable-thinking"],
        "bfcl": [],
        "tau2": ["--enable-thinking"],
        "harbor": ["--enable-thinking", "--agent-kwarg", "model_info={\"max_input_tokens\": 262144}"]
      }
    },
    "apertus-1.5-8b-thinking": {
      "description": "swiss-ai/Apertus-v1.5-8B reasoning (--thinking with its <|inner_prefix|> / <|inner_suffix|> tokens). Window 32768.",
      "max_length": 32768,
      "sampling": "thinking",
      "flags": {
        "lm_eval": ["--thinking", "--think-start-token", "<|inner_prefix|>", "--think-end-token", "<|inner_suffix|>"],
        "inspect": ["--enable-thinking"],
        "bfcl": [],
        "tau2": ["--enable-thinking"],
        "harbor": ["--enable-thinking", "--agent-kwarg", "model_info={\"max_input_tokens\": 32768}"]
      }
    },
    "qwen3-32b-thinking": {
      "description": "Qwen/Qwen3-32B reasoning (--thinking with explicit <think> / </think> tokens). Window 32768, its native context.",
      "max_length": 32768,
      "sampling": "thinking",
      "flags": {
        "lm_eval": ["--thinking", "--think-end-token", "</think>", "--think-start-token", "<think>"],
        "inspect": ["--enable-thinking"],
        "bfcl": [],
        "tau2": ["--enable-thinking"],
        "harbor": ["--enable-thinking", "--agent-kwarg", "model_info={\"max_input_tokens\": 32768}"]
      }
    },
    "chonk-lc-16k-v0.2-sft": {
      "description": "SwissAI-Research/swiss-ai/chonk-lc-16k-v0.2-sft. No Jinja template exists: apertus-common renders the format, in lm_eval (--chat-format apertus2, completions endpoint, needs --backend openai and the verified Apertus_2_instruct tokenizer, pinned in `tokenizer`) and on the server for the other frameworks (vLLM plugin of apertus-common, see docs/thinking.md). Served with a 32768 window although the checkpoint's max_position_embeddings is 16384 (plain RoPE), so what it does past 16k is untrained: read those scores with that in mind. The server only starts with VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 (launch.env). It only reasons at effort high on non-math tasks.",
      "max_length": 32768,
      "sampling": "thinking",
      "reasoning_effort": "high",
      "tokenizer": {"repo": "https://github.com/swiss-ai/apertus-omni-tokenizer.git", "revision": "b801ff1b00d933d10bba90b0c22307157299faa7", "path": "tokenizers/Apertus_2_instruct"},
      "serving": ["--tokenizer-mode", "apertus2", "--reasoning-parser", "apertus2", "--enable-auto-tool-choice", "--tool-call-parser", "apertus2"],
      "launch": {
        "model_path": "/capstor/store/cscs/swissai/infra01/hf-checkpoints/swiss-ai/chonk-lc-16k-v0.2-sft",
        "environment": "containers/env_vllm_apertus2.toml",
        "nodes": 2,
        "time": "24:00:00",
        "env": {"VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1"},
        "framework_args": ["--trust-remote-code", "--dtype", "bfloat16", "--max-model-len", "32768", "--tensor-parallel-size", "1", "--data-parallel-size", "8", "--data-parallel-size-local", "4", "--data-parallel-backend", "ray", "--enable-expert-parallel", "--all2all-backend", "allgather_reducescatter", "--moe-backend", "triton", "--numa-bind", "--load-format", "runai_streamer", "--gpu-memory-utilization", "0.95", "--max-num-seqs", "8", "--max-num-batched-tokens", "512", "--api-server-count", "4"]
      },
      "flags": {
        "lm_eval": ["--backend", "openai", "--chat-format", "apertus2"],
        "inspect": [],
        "bfcl": [],
        "tau2": [],
        "harbor": ["--agent-kwarg", "model_info={\"max_input_tokens\": 32768}"]
      }
    },
    "chonk-lc-16k-v0.1-ep1": {
      "description": "Same settings as chonk-lc-16k-v0.2-sft (apertus-common format, 32k window, effort high, tokenizer and serving options), for the earlier chonk-lc-16k-v0.1-ep1 checkpoint.",
      "max_length": 32768,
      "sampling": "thinking",
      "reasoning_effort": "high",
      "tokenizer": {"repo": "https://github.com/swiss-ai/apertus-omni-tokenizer.git", "revision": "b801ff1b00d933d10bba90b0c22307157299faa7", "path": "tokenizers/Apertus_2_instruct"},
      "serving": ["--tokenizer-mode", "apertus2", "--reasoning-parser", "apertus2", "--enable-auto-tool-choice", "--tool-call-parser", "apertus2"],
      "launch": {
        "model_path": "/capstor/store/cscs/swissai/infra01/hf-checkpoints/chonk-lc-16k-v0.1-ep1/iter_0019374",
        "environment": "containers/env_vllm_apertus2.toml",
        "nodes": 2,
        "time": "24:00:00",
        "env": {"VLLM_ALLOW_LONG_MAX_MODEL_LEN": "1"},
        "framework_args": ["--trust-remote-code", "--dtype", "bfloat16", "--max-model-len", "32768", "--tensor-parallel-size", "1", "--data-parallel-size", "8", "--data-parallel-size-local", "4", "--data-parallel-backend", "ray", "--enable-expert-parallel", "--all2all-backend", "allgather_reducescatter", "--moe-backend", "triton", "--numa-bind", "--load-format", "runai_streamer", "--gpu-memory-utilization", "0.95", "--max-num-seqs", "8", "--max-num-batched-tokens", "512", "--api-server-count", "4"]
      },
      "flags": {
        "lm_eval": ["--backend", "openai", "--chat-format", "apertus2"],
        "inspect": [],
        "bfcl": [],
        "tau2": [],
        "harbor": ["--agent-kwarg", "model_info={\"max_input_tokens\": 32768}"]
      }
    }
  }
}
